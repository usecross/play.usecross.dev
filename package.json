{
  "name": "play.usecross.dev",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare:runtime": "bun scripts/prepare-runtime.ts",
    "dev": "bun run prepare:runtime && bun --filter @play.usecross.dev/shell dev",
    "build": "bun run prepare:runtime && bun --filter @play.usecross.dev/shell build",
    "preview": "bun --filter @play.usecross.dev/shell preview",
    "deploy": "bun scripts/check-runtime-release.ts && bun run build && wrangler deploy",
    "test": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:python": "bun run prepare:runtime && bun scripts/test-python.ts",
    "typecheck": "tsc --noEmit -p packages/runner/tsconfig.json && tsc --noEmit -p apps/shell/tsconfig.json",
    "test:install": "npx playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "wrangler": "^4.50.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
